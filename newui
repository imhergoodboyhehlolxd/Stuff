                Value = { },
                OptionCount = 1,
                Options = { }
            }

            local Items = { } do
                Items["Listbox"] = Instances:Create("ImageLabel", {
                    Parent = Dropdown.Section.Items["Content"].Instance,
                    Name = "\0",
                    ScaleType = Enum.ScaleType.Slice,
                    BorderColor3 = FromRGB(0, 0, 0),
